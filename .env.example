# public.safe configuration. Copy to .env (git-ignored) and edit.
# Every variable here is a field of backend/publicsafe/config.py (Settings).
# Booleans accept 1/0, true/false, yes/no.

# ---- application ------------------------------------------------------------
# development | production | test. production refuses TEST_MODE.
APP_ENV=development
# Bind address and port of the HTTPS server (uvicorn).
HOST=0.0.0.0
PORT=8443
# mkcert certificate + key (created by `make certs`).
SSL_CERTFILE=certs/dev.pem
SSL_KEYFILE=certs/dev-key.pem
# Optional explicit origin used in pairing URLs/QR codes (default: the request's Host).
# Example: https://192.168.0.20:8443
PUBLIC_URL=
# Built frontend served by FastAPI in `make run` (Vite serves it in `make dev`).
FRONTEND_DIST=frontend/dist
# Runtime data root: SQLite file, recordings, eval outputs (git-ignored).
DATA_DIR=data
# Logging: level and JSON formatting (structured logs land in M6).
LOG_LEVEL=INFO
LOG_JSON=true

# ---- admin account (F-ADM-1) ------------------------------------------------
ADMIN_USERNAME=admin
# argon2id hash written by `publicsafe admin set-password` (M1). The server
# refuses to start while this is empty and prints that command.
ADMIN_PASSWORD_HASH=
# Idle expiry of the admin session cookie, hours (F-ADM-2).
SESSION_IDLE_HOURS=12

# ---- database (Section K) ---------------------------------------------------
# SQLite by default; PostgreSQL via postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite+pysqlite:///data/publicsafe.db
# Run `alembic upgrade head` automatically at start (M1).
AUTO_MIGRATE=true

# ---- pairing (Section G) ----------------------------------------------------
# letters (BCDFGHJKLMNPQRSTVWXZ, ~25.9 bits) | digits (6 decimal digits, ~19.9 bits)
PIN_ALPHABET=letters
# Pairing code lifetime in seconds (30..3600) and wrong attempts before lock (1..20).
PIN_TTL_SECONDS=300
PIN_MAX_ATTEMPTS=5

# ---- inference and scheduling (Section H) -----------------------------------
# YOLOv8n weights; a relative path lives under DATA_DIR/models and is downloaded on first start.
MODEL_PATH=yolov8n.pt
# Empty = auto (mps -> cuda -> cpu). Or: mps | cuda | cpu
INFERENCE_DEVICE=
# FP16 inference (measure before enabling; see docs/EVALUATION.md).
INFERENCE_HALF=false
# Inference image size (long edge) passed to ultralytics.
INFERENCE_IMGSZ=640
# latest (per-camera mailbox + round robin, default) | fifo (experiments only)
SCHEDULER_STRATEGY=latest
# Max accepted JPEG size in bytes; larger frames close the socket with 1009.
MAX_FRAME_BYTES=1500000
# yolo (YOLOv8n person detector, default) | fake (scripted, tests/load test) | none (pass-through)
DETECTOR=yolo
# Simulated inference time for the fake detector (load test uses 20).
FAKE_DETECTOR_SLEEP_MS=0
# Phone sending > 3x target fps for this long is closed with 4008.
RATE_ABUSE_SECONDS=10
# MetricSample rows are written per camera at this interval.
METRIC_SAMPLE_INTERVAL_S=5

# ---- websockets and liveness --------------------------------------------------
# Seconds a phone socket may stay silent before the first `auth` message (close 4001).
WS_AUTH_TIMEOUT_S=5
# No frame or ping for this long -> camera `offline` (checked every SWEEP_INTERVAL_S).
OFFLINE_AFTER_S=10
SWEEP_INTERVAL_S=2
# Interval of the `metrics` message pushed to dashboards.
METRICS_INTERVAL_S=2
# Server acknowledges every N-th frame to the phone.
ACK_EVERY=10

# ---- modes ------------------------------------------------------------------
# Write every processed frame + FrameResult to data/recordings/ (F-EVAL-2). Off by default.
EVAL_RECORD=false
# Enable /api/test/* endpoints for Playwright and fake-phone tests. Never in production.
TEST_MODE=false
